# Скопировать в .env и заполнить. Файл .env в .gitignore и в .dockerignore:
# ни в репозиторий, ни в образ он не попадает.

# ── Telegram ────────────────────────────────────────────────────────────────
# api_id и api_hash берутся на my.telegram.org → API development tools.
DIARY_TELEGRAM_API_ID=0
DIARY_TELEGRAM_API_HASH=
DIARY_TELEGRAM_PHONE=+70000000000

# Пароль двухфакторной аутентификации. Оставь пустым, если её нет —
# тогда при необходимости программа спросит его в терминале.
DIARY_Telegram__Password=

# Код подтверждения задать заранее нельзя: он приходит в момент входа
# и вводится в терминале. Именно поэтому вход делается через
# `docker compose run`, а не через `up`.

# ── Модель ──────────────────────────────────────────────────────────────────
# Хост виден из контейнера как host.docker.internal.
DIARY_LLM_ENDPOINT=http://host.docker.internal:1234/v1
DIARY_MODEL=qwen/qwen3.5-9b

# Для профиля bundled, где модель поднимается в контейнере рядом.
DIARY_BUNDLED_MODEL=qwen3:8b
