// Скопировать в docker/appsettings.Local.json — он монтируется в контейнер
// и лежит в .gitignore.
//
// Субъекты задаются файлом, а не переменными окружения: массивы в IConfiguration
// сливаются поэлементно, и задавать их через DIARY_Subjects__0__Sources__0__Peer
// можно, но читать потом невозможно.
{
  "Subjects": [
    {
      // Отладочный субъект под samples/messages.jsonl — работает без Telegram.
      "Key": "sample",
      "DisplayName": "Отладочный субъект",
      "TimeZone": "Europe/Moscow",
      "Modules": [ "gi", "notes" ],
      "Sources": [
        { "Peer": "@sample", "SenderIds": [ 777 ] }
      ],
      "Retention": { "Mode": "Keep", "DryRun": true }
    },
    {
      // Настоящий дневник. Peer — приватный канал или собственный username
      // (тогда это «Избранное»).
      "Key": "me",
      "DisplayName": "Я",
      "TimeZone": "Europe/Moscow",
      "Modules": [ "gi", "notes" ],
      "Sources": [
        { "Peer": "@my_diary_channel", "Exclusive": true }
      ],
      // Удаление — единственная необратимая операция. Включать осознанно
      // и сначала с DryRun.
      "Retention": { "Mode": "Keep", "DryRun": true }
    }
  ],

  "Analysis": {
    "MinSupport": 3,
    "UseCalibratedWindows": true
  }
}
