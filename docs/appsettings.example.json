// Пример appsettings.Local.json — положить рядом с исполняемым файлом.
// Этот файл в .gitignore: в нём peer'ы, id отправителей и настройки удаления.
//
// Массивы в IConfiguration сливаются поэлементно, поэтому Subjects задаётся
// целиком здесь, а в appsettings.json он намеренно пуст.
{
  "Subjects": [
    {
      "Key": "me",
      "DisplayName": "Андрей",
      "TimeZone": "Europe/Moscow",
      "Modules": [ "gi", "notes" ],
      "Sources": [
        // Весь канал мой, включая посты от имени канала.
        { "Peer": "@my_diary_channel", "Exclusive": true }
      ],
      "Retention": { "Mode": "React", "MinAge": "7.00:00:00", "DryRun": false }
    },
    {
      "Key": "mom",
      "DisplayName": "Мама",
      "TimeZone": "Europe/Samara",
      "Modules": [ "gi" ],
      "Sources": [
        // Общая группа: субъекта определяет отправитель, а не чат.
        // SenderIds — числовые id; узнать их можно из карантина после первого sync.
        { "Peer": -1001234567890, "SenderIds": [ 987654321 ] }
      ],
      "Retention": { "Mode": "Keep" },
      "Analysis": { "MinSupport": 4 }
    }
  ],

  "Telegram": {
    // api_id и api_hash — с my.telegram.org. Лучше через переменные окружения:
    // DIARY_Telegram__ApiId, DIARY_Telegram__ApiHash
    "ApiId": 0,
    "ApiHash": "",
    "PhoneNumber": "+70000000000",
    "SessionFile": "data/telegram.session",
    "MarkAsRead": true
  },

  "Llm": {
    "Roles": {
      "Segmentation": { "Model": "qwen/qwen3.5-9b" },
      "Extraction": { "Model": "qwen/qwen3.5-9b" },
      "Answering": { "Model": "qwen/qwen3.5-9b" }
    }
  },

  "Speech": {
    "ModelPath": "models/ggml-large-v3-turbo.bin"
  }
}
