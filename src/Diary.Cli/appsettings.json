{
  "DataDirectory": "data",
  "ReportDirectory": "reports",
  "ForwardPolicy": "Skip",

  // Субъекты задаются в appsettings.Local.json — он не попадает в git.
  // Пример: docs/appsettings.example.json
  // Здесь намеренно пусто: массивы в IConfiguration сливаются поэлементно, и оставленный
  // тут «пример» молча подмешивал бы свои поля в реальную конфигурацию.
  "Subjects": [],

  "Retention": {
    "Mode": "Keep",
    "RequiresState": "Extracted",
    "MinAge": "7.00:00:00",
    "KeepFailed": true,
    "DryRun": true
  },

  "Analysis": {
    "MinSupport": 3,
    "MinLift": 1.5,
    "UseCalibratedWindows": true,
    "CalibrationMinSamples": 8
  },

  "Telegram": {
    "ApiId": 0,
    "ApiHash": "",
    "PhoneNumber": "",
    "SessionFile": "data/telegram.session",
    "MarkAsRead": true,
    "PageSize": 100
  },

  "Llm": {
    "Endpoint": "http://localhost:1234/v1",
    "ApiKey": "lm-studio",
    "DisableThinking": true,
    "ReasoningEffort": "none",
    "TimeoutSeconds": 300,
    "RepairAttempts": 1,
    "MaxToolRounds": 4,
    "Roles": {
      "Segmentation": { "Model": "qwen/qwen3.5-9b", "Temperature": 0.1, "Seed": 42 },
      "Extraction": { "Model": "qwen/qwen3.5-9b", "Temperature": 0.1, "Seed": 42 },
      "Answering": { "Model": "qwen/qwen3.5-9b", "Temperature": 0.3 }
    }
  },

  "Speech": {
    // Whisper | NativeAudio | Hybrid
    "Reader": "Whisper",
    "ModelPath": "models/ggml-large-v3-turbo.bin",
    "Language": "ru",
    "NativeAudioModel": "",
    "HybridConfidenceThreshold": 0.6
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
